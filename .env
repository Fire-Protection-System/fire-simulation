FIRE_SIMULATION_EXCHANGE_NAME="fire_updates"
FIRE_SIMULATION_USERNAME="guest"
FIRE_SIMULATION_PASSWORD="guest"
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
WRITE_QUEUE_TOPICS=["Forester patrol state topic","Camera topic","Temp and air humidity topic","Wind speed topic","Wind direction topic","Litter moisture topic","CO2 topic","PM2.5 topic","Fire brigades state topic","Recommended action topic","Sector state topic"]
READ_QUEUE_TOPICS=["Forester patrol action queue","Fire brigades action queue"]
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MONGO_INITDB_DATABASE=fire
MONGO_PORT=27017
SIMULATOR_PORT=5000
BACKEND_PORT=8181
CONFIG_PORT=31415
RABBITMQ_MANAGEMENT_PORT=15672
BUILD_ENV=development
SPRING_PROFILE=dev
SONAR_TOKEN=***
SONAR_HOST_URL=http://sonarqube:9000
LOG_DIRECTORY=/var/log/fire-simulation
MONGO_CONNECTION=mongodb://mongo:27017/configurations
LOG_LEVEL=DEBUG
LOG_FILE_NAME=/var/log/fire-backend/application.log
